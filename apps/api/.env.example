NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://apartman:apartman@localhost:5433/apartman?schema=public
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:5173

# En az 32 karakter: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=degistirin-en-az-32-karakterlik-rastgele-bir-deger

LOGIN_RATE_LIMIT=10

# Yüklenen makbuz, fatura ve fotoğrafların klasörü. Yedeklemeye dahil edilmelidir.
UPLOAD_DIR=uploads

# SMS ve WhatsApp sağlayıcısı. "log" mesajları göndermez, yalnızca kaydeder.
# Gerçek sağlayıcı seçildiğinde hesap müşteri adına açılır ve bilgileri buraya girilir.
MESSAGING_PROVIDER=log
