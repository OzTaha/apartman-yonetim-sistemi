generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SiteKind {
  APARTMENT
  SITE
}

enum SiteRole {
  SITE_MANAGER
  RESIDENT
}

enum OccupancyType {
  OWNER
  TENANT
}

enum DistributionMethod {
  EQUAL
  AREA
  LAND_SHARE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE
}

enum CashAccountKind {
  CASH
  BANK
}

enum FinanceKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum EmployeeRole {
  DOORMAN
  SECURITY
  CLEANING
  GARDENER
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskEventKind {
  CREATED
  EDITED
  ASSIGNED
  STATUS
  NOTE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AnnouncementAudience {
  ALL
  BLOCKS
  UNITS
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum CampaignKind {
  DUES_REMINDER
  ANNOUNCEMENT
  EMERGENCY
  INFO
}

enum RecipientFilter {
  ALL
  BLOCKS
  UNITS
  DEBTORS
  OVERDUE
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  firstName       String
  lastName        String
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships       SiteMembership[]
  occupancies       Occupancy[]
  refreshTokens     RefreshToken[]
  announcementReads AnnouncementRead[]

  @@map("users")
}

model Site {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  kind      SiteKind @default(SITE)
  address   String?
  city      String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       SiteMembership[]
  blocks            Block[]
  units             Unit[]
  occupancies       Occupancy[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  chargeTypes       ChargeType[]
  duesPlans         DuesPlan[]
  charges           Charge[]
  payments          Payment[]
  allocations       PaymentAllocation[]
  accounts          CashAccount[]
  categories        FinanceCategory[]
  vendors           Vendor[]
  works             Work[]
  transactions      Transaction[]
  attachments       Attachment[]
  closings          MonthClosing[]
  counters          SiteCounter[]
  employees         Employee[]
  shifts            Shift[]
  tasks             Task[]
  taskEvents        TaskEvent[]
  recurringTasks    RecurringTask[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  messageTemplates  MessageTemplate[]
  campaigns         MessageCampaign[]
  deliveries        MessageDelivery[]

  @@map("sites")
}

model SiteMembership {
  id        String   @id @default(uuid(7)) @db.Uuid
  siteId    String   @db.Uuid
  userId    String   @db.Uuid
  role      SiteRole
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([userId])
  @@map("site_memberships")
}

model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  siteId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  units Unit[]

  @@unique([siteId, name])
  @@unique([id, siteId])
  @@map("blocks")
}

model Unit {
  id         String    @id @default(uuid(7)) @db.Uuid
  siteId     String    @db.Uuid
  blockId    String    @db.Uuid
  number     String
  floor      Int?
  areaM2     Float?
  landShare  Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  block       Block       @relation(fields: [blockId, siteId], references: [id, siteId], onDelete: Restrict)
  occupancies Occupancy[]
  charges     Charge[]
  payments    Payment[]

  @@unique([blockId, number])
  @@unique([id, siteId])
  @@index([siteId])
  @@map("units")
}

model Occupancy {
  id                   String        @id @default(uuid(7)) @db.Uuid
  siteId               String        @db.Uuid
  unitId               String        @db.Uuid
  userId               String?       @db.Uuid
  firstName            String
  lastName             String
  phone                String?
  email                String?
  type                 OccupancyType
  startDate            DateTime      @db.Date
  endDate              DateTime?     @db.Date
  isResponsibleForDues Boolean       @default(true)
  contactConsent       Boolean       @default(false)
  contactConsentAt     DateTime?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations Invitation[]

  @@unique([id, siteId])
  @@index([siteId, endDate])
  @@index([unitId])
  @@index([userId])
  @@map("occupancies")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  siteId      String    @db.Uuid
  occupancyId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  occupancy Occupancy @relation(fields: [occupancyId, siteId], references: [id, siteId], onDelete: Cascade)

  @@index([occupancyId])
  @@map("invitations")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  siteId     String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ChargeType {
  id        String   @id @default(uuid(7)) @db.Uuid
  siteId    String   @db.Uuid
  code      String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@unique([siteId, name])
  @@unique([siteId, code])
  @@unique([id, siteId])
  @@map("charge_types")
}

model DuesPlan {
  id          String             @id @default(uuid(7)) @db.Uuid
  siteId      String             @db.Uuid
  method      DistributionMethod
  amountKurus Int
  validFrom   String
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now())

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@index([siteId, validFrom])
  @@map("dues_plans")
}

model Charge {
  id            String    @id @default(uuid(7)) @db.Uuid
  siteId        String    @db.Uuid
  unitId        String    @db.Uuid
  chargeTypeId  String    @db.Uuid
  duesPlanId    String?   @db.Uuid
  period        String?
  description   String?
  amountKurus   Int
  issueDate     DateTime  @db.Date
  dueDate       DateTime  @db.Date
  accrualKey    String?   @unique
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?   @db.Uuid

  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unit        Unit                @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  chargeType  ChargeType          @relation(fields: [chargeTypeId, siteId], references: [id, siteId], onDelete: Restrict)
  duesPlan    DuesPlan?           @relation(fields: [duesPlanId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@unique([id, siteId])
  @@index([siteId, period])
  @@index([unitId, dueDate])
  @@map("charges")
}

model Payment {
  id            String        @id @default(uuid(7)) @db.Uuid
  siteId        String        @db.Uuid
  unitId        String        @db.Uuid
  receiptNo     Int?
  amountKurus   Int
  method        PaymentMethod
  paidAt        DateTime      @db.Date
  reference     String?
  note          String?
  createdById   String?       @db.Uuid
  createdAt     DateTime      @default(now())
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?       @db.Uuid

  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unit        Unit                @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  allocations PaymentAllocation[]
  transaction Transaction?
  attachments Attachment[]

  @@unique([id, siteId])
  @@unique([siteId, receiptNo])
  @@index([siteId, paidAt])
  @@index([unitId])
  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  siteId      String   @db.Uuid
  paymentId   String   @db.Uuid
  chargeId    String   @db.Uuid
  amountKurus Int
  createdAt   DateTime @default(now())

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId, siteId], references: [id, siteId], onDelete: Cascade)
  charge  Charge  @relation(fields: [chargeId, siteId], references: [id, siteId], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

model SiteCounter {
  siteId String @db.Uuid
  name   String
  value  Int    @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, name])
  @@map("site_counters")
}

model CashAccount {
  id                  String          @id @default(uuid(7)) @db.Uuid
  siteId              String          @db.Uuid
  code                String?
  name                String
  kind                CashAccountKind
  openingBalanceKurus Int             @default(0)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionAccount")
  transfersIn  Transaction[] @relation("TransactionToAccount")

  @@unique([siteId, name])
  @@unique([siteId, code])
  @@unique([id, siteId])
  @@map("cash_accounts")
}

model FinanceCategory {
  id        String      @id @default(uuid(7)) @db.Uuid
  siteId    String      @db.Uuid
  code      String?
  kind      FinanceKind
  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([siteId, kind, name])
  @@unique([siteId, code])
  @@unique([id, siteId])
  @@map("finance_categories")
}

model Vendor {
  id        String   @id @default(uuid(7)) @db.Uuid
  siteId    String   @db.Uuid
  name      String
  phone     String?
  taxNumber String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  works        Work[]
  transactions Transaction[]

  @@unique([siteId, name])
  @@unique([id, siteId])
  @@map("vendors")
}

model Work {
  id                 String     @id @default(uuid(7)) @db.Uuid
  siteId             String     @db.Uuid
  title              String
  description        String?
  vendorId           String?    @db.Uuid
  startDate          DateTime?  @db.Date
  endDate            DateTime?  @db.Date
  agreedKurus        Int?
  status             WorkStatus @default(PLANNED)
  visibleToResidents Boolean    @default(true)
  createdById        String?    @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendor       Vendor?       @relation(fields: [vendorId, siteId], references: [id, siteId], onDelete: Restrict)
  transactions Transaction[]
  attachments  Attachment[]

  @@unique([id, siteId])
  @@index([siteId, createdAt])
  @@map("works")
}

model Transaction {
  id                 String          @id @default(uuid(7)) @db.Uuid
  siteId             String          @db.Uuid
  type               TransactionType
  amountKurus        Int
  date               DateTime        @db.Date
  accountId          String          @db.Uuid
  toAccountId        String?         @db.Uuid
  categoryId         String?         @db.Uuid
  vendorId           String?         @db.Uuid
  workId             String?         @db.Uuid
  employeeId         String?         @db.Uuid
  paymentId          String?         @db.Uuid
  description        String?
  documentNo         String?
  visibleToResidents Boolean         @default(true)
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now())
  cancelledAt        DateTime?
  cancelReason       String?
  cancelledById      String?         @db.Uuid

  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  account     CashAccount      @relation("TransactionAccount", fields: [accountId, siteId], references: [id, siteId], onDelete: Restrict)
  toAccount   CashAccount?     @relation("TransactionToAccount", fields: [toAccountId, siteId], references: [id, siteId], onDelete: Restrict)
  category    FinanceCategory? @relation(fields: [categoryId, siteId], references: [id, siteId], onDelete: Restrict)
  vendor      Vendor?          @relation(fields: [vendorId, siteId], references: [id, siteId], onDelete: Restrict)
  work        Work?            @relation(fields: [workId, siteId], references: [id, siteId], onDelete: Restrict)
  employee    Employee?        @relation(fields: [employeeId, siteId], references: [id, siteId], onDelete: Restrict)
  payment     Payment?         @relation(fields: [paymentId, siteId], references: [id, siteId], onDelete: Restrict)
  attachments Attachment[]

  @@unique([id, siteId])
  @@unique([paymentId, siteId])
  @@index([siteId, date])
  @@index([accountId])
  @@index([workId])
  @@index([vendorId])
  @@index([employeeId])
  @@map("transactions")
}

model Attachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  siteId         String   @db.Uuid
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String   @unique
  sha256         String
  transactionId  String?  @db.Uuid
  workId         String?  @db.Uuid
  paymentId      String?  @db.Uuid
  announcementId String?  @db.Uuid
  uploadedById   String?  @db.Uuid
  createdAt      DateTime @default(now())

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transaction  Transaction?  @relation(fields: [transactionId, siteId], references: [id, siteId], onDelete: Restrict)
  work         Work?         @relation(fields: [workId, siteId], references: [id, siteId], onDelete: Restrict)
  payment      Payment?      @relation(fields: [paymentId, siteId], references: [id, siteId], onDelete: Restrict)
  announcement Announcement? @relation(fields: [announcementId, siteId], references: [id, siteId], onDelete: Restrict)

  @@index([transactionId])
  @@index([workId])
  @@index([paymentId])
  @@index([announcementId])
  @@map("attachments")
}

model MonthClosing {
  id         String   @id @default(uuid(7)) @db.Uuid
  siteId     String   @db.Uuid
  period     String
  summary    Json
  closedById String?  @db.Uuid
  closedAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, period])
  @@map("month_closings")
}

model Employee {
  id        String       @id @default(uuid(7)) @db.Uuid
  siteId    String       @db.Uuid
  firstName String
  lastName  String
  role      EmployeeRole
  phone     String?
  startDate DateTime?    @db.Date
  notes     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  tasks          Task[]
  recurringTasks RecurringTask[]
  transactions   Transaction[]

  @@unique([id, siteId])
  @@index([siteId])
  @@map("employees")
}

model Shift {
  id          String   @id @default(uuid(7)) @db.Uuid
  siteId      String   @db.Uuid
  employeeId  String   @db.Uuid
  date        DateTime @db.Date
  startTime   String
  endTime     String
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, siteId], references: [id, siteId], onDelete: Restrict)

  @@index([siteId, date])
  @@index([employeeId, date])
  @@map("shifts")
}

model RecurringTask {
  id          String              @id @default(uuid(7)) @db.Uuid
  siteId      String              @db.Uuid
  title       String
  description String?
  employeeId  String?             @db.Uuid
  priority    TaskPriority        @default(NORMAL)
  frequency   RecurrenceFrequency
  weekdays    Int[]
  dayOfMonth  Int?
  startDate   DateTime            @db.Date
  endDate     DateTime?           @db.Date
  isActive    Boolean             @default(true)
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId, siteId], references: [id, siteId], onDelete: Restrict)
  tasks    Task[]

  @@unique([id, siteId])
  @@map("recurring_tasks")
}

model Task {
  id              String       @id @default(uuid(7)) @db.Uuid
  siteId          String       @db.Uuid
  title           String
  description     String?
  employeeId      String?      @db.Uuid
  dueDate         DateTime?    @db.Date
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(TODO)
  completedAt     DateTime?
  recurringTaskId String?      @db.Uuid
  occurrenceDate  DateTime?    @db.Date
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee      Employee?      @relation(fields: [employeeId, siteId], references: [id, siteId], onDelete: Restrict)
  recurringTask RecurringTask? @relation(fields: [recurringTaskId, siteId], references: [id, siteId], onDelete: Restrict)
  events        TaskEvent[]

  @@unique([id, siteId])
  @@unique([recurringTaskId, occurrenceDate])
  @@index([siteId, status])
  @@index([employeeId])
  @@map("tasks")
}

model TaskEvent {
  id           String        @id @default(uuid(7)) @db.Uuid
  siteId       String        @db.Uuid
  taskId       String        @db.Uuid
  kind         TaskEventKind
  status       TaskStatus?
  assigneeName String?
  note         String?
  userId       String?       @db.Uuid
  createdAt    DateTime      @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId, siteId], references: [id, siteId], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_events")
}

model Announcement {
  id          String               @id @default(uuid(7)) @db.Uuid
  siteId      String               @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  blockIds    String[]             @db.Uuid
  unitIds     String[]             @db.Uuid
  pinned      Boolean              @default(false)
  expiresAt   DateTime?            @db.Date
  publishedAt DateTime             @default(now())
  createdById String?              @db.Uuid
  updatedAt   DateTime             @updatedAt

  site        Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reads       AnnouncementRead[]
  attachments Attachment[]
  campaigns   MessageCampaign[]

  @@unique([id, siteId])
  @@index([siteId, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid(7)) @db.Uuid
  siteId         String   @db.Uuid
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId, siteId], references: [id, siteId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model MessageTemplate {
  id        String       @id @default(uuid(7)) @db.Uuid
  siteId    String       @db.Uuid
  name      String
  kind      CampaignKind
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@map("message_templates")
}

model MessageCampaign {
  id             String          @id @default(uuid(7)) @db.Uuid
  siteId         String          @db.Uuid
  kind           CampaignKind
  channel        MessageChannel
  filter         RecipientFilter
  blockIds       String[]        @db.Uuid
  unitIds        String[]        @db.Uuid
  body           String
  announcementId String?         @db.Uuid
  autoKey        String?
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  announcement Announcement?     @relation(fields: [announcementId, siteId], references: [id, siteId], onDelete: Restrict)
  deliveries   MessageDelivery[]

  @@unique([id, siteId])
  @@unique([siteId, autoKey])
  @@index([siteId, createdAt])
  @@map("message_campaigns")
}

model MessageDelivery {
  id                String         @id @default(uuid(7)) @db.Uuid
  siteId            String         @db.Uuid
  campaignId        String         @db.Uuid
  occupancyId       String?        @db.Uuid
  name              String
  blockName         String?
  unitNumber        String?
  phone             String?
  text              String
  status            DeliveryStatus @default(QUEUED)
  error             String?
  attempts          Int            @default(0)
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  campaign MessageCampaign @relation(fields: [campaignId, siteId], references: [id, siteId], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("message_deliveries")
}
