# Bu dosya kurulumda install.sh tarafından sunucuda .env olarak üretilir.
# Gizli değerler her kurulumda rastgele oluşturulur; bu örnektekiler kullanılmaz.

DOMAIN=yonetim.ornekapartman.com
ACME_EMAIL=yonetim@ornekapartman.com

POSTGRES_PASSWORD=degistirin
REDIS_PASSWORD=degistirin
JWT_ACCESS_SECRET=degistirin-en-az-32-karakterlik-rastgele-bir-deger

MESSAGING_PROVIDER=log
PAYMENT_PROVIDER=none

BACKUP_DIR=/var/backups/apartman
BACKUP_KEEP_DAYS=14

# Dış depoya yedek (isteğe bağlı): S3 uyumlu depo bilgileri müşteri hesabından alınır.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
